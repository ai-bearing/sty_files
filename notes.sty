% notes.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes}
%\renewcommand{\mathbb}{\mathds}

\ifdefined\HCode
  % HTML build (tex4ht): skip tcolorbox -- it is fragile under tex4ht.
  % mathnotes.cfg wraps these environments in semantic <div>s with CSS instead.
\else
  \RequirePackage[most]{tcolorbox}

  \tcolorboxenvironment{definition}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{green!75!black}, parbox=false }
  \tcolorboxenvironment{theorem}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{blue!50!black}, parbox=false }
  \tcolorboxenvironment{proposition}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{blue!50!black}, parbox=false }
  \tcolorboxenvironment{lemma}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{blue!50!black}, parbox=false }
  \tcolorboxenvironment{corollary}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{blue!50!black}, parbox=false }
  \tcolorboxenvironment{proof}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{gray}, parbox=false }
  \tcolorboxenvironment{remark}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{blue!50!white}, parbox=false }
  \tcolorboxenvironment{note}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{gray}, parbox=false }
  \tcolorboxenvironment{aside}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{gray}, parbox=false }
  \tcolorboxenvironment{example}{ blanker, breakable, left=4mm, before skip=6pt, after skip=6pt, borderline west={1pt}{0pt}{gray}, parbox=false }
\fi
